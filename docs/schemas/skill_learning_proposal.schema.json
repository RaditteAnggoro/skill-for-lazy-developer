{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["proposal_id", "status", "owner_skill", "reference_target", "trigger", "suggested_rule", "why", "evidence", "constraints", "privacy_review", "security_review", "baseline_eval", "candidate_eval", "approval"],
  "properties": {
    "proposal_id": {"type": "string", "pattern": "^skill-lesson-[0-9]{8}-[0-9]{3}$"},
    "status": {"const": "candidate"},
    "owner_skill": {"type": "string"},
    "reference_target": {"type": "string"},
    "trigger": {"type": "string", "minLength": 3},
    "suggested_rule": {"type": "string", "minLength": 10},
    "why": {"type": "string", "minLength": 10},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["type", "case_id", "result"],
        "properties": {"type": {"type": "string"}, "case_id": {"type": "string"}, "result": {"enum": ["observed_fail_then_pass", "observed_pass", "observed_fail", "not_observed"]}},
        "additionalProperties": false}
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "privacy_review": {"type": "string"},
    "security_review": {"type": "string"},
    "baseline_eval": {"type": "string"},
    "candidate_eval": {"type": "string"},
    "approval": {"type": "string"}
  },
  "additionalProperties": false
}
